# Backend service (NestJS). On Railway set these on the BACKEND service only.

NODE_ENV=development
PORT=4000
WEB_URL=http://localhost:3000

# PostgreSQL — on Railway use a reference variable so it tracks the DB service:
#   DATABASE_URL=${{ Postgres.DATABASE_URL }}
DATABASE_URL=postgresql://haven:haven_dev_password@localhost:5432/haven?schema=public

# Redis — on Railway: REDIS_URL=${{ Redis.REDIS_URL }}
REDIS_URL=redis://:haven_redis_dev@localhost:6379

# Authentication — replace every value outside local development
JWT_ACCESS_SECRET=replace-with-at-least-32-random-characters
JWT_MFA_SECRET=replace-with-a-separate-32-character-secret
ACCESS_TOKEN_TTL=10m
REFRESH_TOKEN_TTL_DAYS=30
COOKIE_DOMAIN=
MFA_ENCRYPTION_KEY=replace-with-base64-encoded-32-byte-key
DATA_ENCRYPTION_KEY=replace-with-a-different-base64-encoded-32-byte-key

# S3-compatible storage (MinIO defaults for local Docker)
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=haven-private
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_FORCE_PATH_STYLE=true

# Observability (optional)
SENTRY_DSN=
LOG_LEVEL=info
