# Frontend service (Next.js). On Railway set these on the FRONTEND service only.
#
# This tier never touches PostgreSQL. Do NOT give it DATABASE_URL or any
# JWT/encryption secret — it reaches the backend over HTTP only.

NODE_ENV=development
PORT=3000

# Where next.config.ts proxies /api/* on the server side.
# Local:    http://localhost:4000
# Railway:  http://${{ backend.RAILWAY_PRIVATE_DOMAIN }}:4000
API_INTERNAL_URL=http://localhost:4000

# Set to 'true' to browse the UI without a running backend.
NEXT_PUBLIC_DEMO_MODE=false
